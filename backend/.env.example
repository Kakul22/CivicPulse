PORT=5000
NODE_ENV=development

# Get this from Neon.tech or Supabase (free Postgres hosting)
DATABASE_URL=postgresql://user:password@host:5432/civicpulse

# Any long random string - used to sign login tokens
JWT_SECRET=change_this_to_a_long_random_string

# Get these from cloudinary.com (free tier) - used for issue photo uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
